# 通用
LLM_PROVIDER=anthropic

# ------ 嵌入与 Rerank 配置 ------
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-large

# Anthropic 配置（LLM_PROVIDER=anthropic 时使用）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# OpenAI 配置（LLM_PROVIDER=openai 时使用）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# MySQL 业务数据库配置
DATABASE_URI=mysql+pymysql://root:123456@localhost:3306/rag_agent?charset=utf8mb4

# PostgreSQL 向量库配置（RAG 检索）
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=rag_vector
VECTOR_DB_USER=postgres
VECTOR_DB_PASSWORD=your_password

# Flask 配置
SECRET_KEY=your-secret-key-change-this-in-production
